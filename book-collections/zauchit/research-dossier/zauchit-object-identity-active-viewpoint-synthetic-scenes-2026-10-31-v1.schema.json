{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "zauchit-object-identity-active-viewpoint-synthetic-scenes-2026-10-31-v1.schema.json",
  "title": "Zaучит AVO illustrative active-viewpoint JSONL record",
  "description": "Strict schema for one of the same ten authored synthetic cards. This package conversion is not an experiment, validated dataset, or benchmark result.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "dataset_id",
    "scene_id",
    "module",
    "status",
    "execution_status",
    "model_input",
    "evaluator_only"
  ],
  "properties": {
    "version": {
      "const": "2026-10-31-v1"
    },
    "dataset_id": {
      "const": "zauchit-object-identity-active-viewpoint-synthetic-scenes"
    },
    "scene_id": {
      "type": "string",
      "enum": [
        "01",
        "02",
        "03",
        "04",
        "05",
        "06",
        "07",
        "08",
        "09",
        "10"
      ]
    },
    "module": {
      "type": "string",
      "enum": [
        "AVO-01",
        "AVO-02",
        "AVO-03",
        "AVO-04",
        "AVO-05"
      ]
    },
    "status": {
      "const": "SYNTHETIC / ILLUSTRATIVE / NOT TESTED"
    },
    "execution_status": {
      "const": "NOT RUN"
    },
    "model_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observation_text",
        "action_menu",
        "response_options",
        "constraints",
        "cost_note"
      ],
      "properties": {
        "observation_text": {
          "type": "string",
          "minLength": 1
        },
        "action_menu": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "command",
              "description",
              "relative_cost"
            ],
            "properties": {
              "command": {
                "type": "string",
                "enum": [
                  "HOLD",
                  "LEFT",
                  "RIGHT",
                  "OBLIQUE",
                  "HEIGHT",
                  "ZOOM",
                  "REPEAT",
                  "STOP",
                  "ABSTAIN"
                ]
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "relative_cost": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "time_ticks",
                  "camera_path_units",
                  "additional_frames"
                ],
                "properties": {
                  "time_ticks": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 2
                  },
                  "camera_path_units": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "additional_frames": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1
                  }
                }
              }
            }
          }
        },
        "response_options": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "same",
              "new",
              "abstain"
            ]
          }
        },
        "constraints": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "max_camera_commands",
            "max_additional_frames",
            "max_time_ticks",
            "max_camera_path_units",
            "scene_static_during_inspection"
          ],
          "properties": {
            "max_camera_commands": {
              "const": 1
            },
            "max_additional_frames": {
              "const": 1
            },
            "max_time_ticks": {
              "const": 2
            },
            "max_camera_path_units": {
              "const": 1
            },
            "scene_static_during_inspection": {
              "const": true
            }
          }
        },
        "cost_note": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "evaluator_only": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference_entity_id",
        "current_entity_id",
        "ground_truth",
        "identity_identifiability_before",
        "identity_identifiability_after_one_action",
        "informative_actions",
        "abstention_allowed",
        "action_outcomes_source",
        "expected_observations_by_action",
        "policy_logic",
        "safe_rule",
        "metric",
        "risk_or_failure_mode",
        "paired_scene_id",
        "pair_and_controls",
        "holdout_group"
      ],
      "properties": {
        "reference_entity_id": {
          "type": "string",
          "pattern": "^E-AVO0[1-5]-REF$"
        },
        "current_entity_id": {
          "type": "string",
          "pattern": "^E-AVO0[1-5]-(?:CONT|REPL)$"
        },
        "ground_truth": {
          "type": "string",
          "enum": [
            "same",
            "new"
          ]
        },
        "identity_identifiability_before": {
          "type": "string",
          "enum": [
            "non_identifiable",
            "identifiable"
          ]
        },
        "identity_identifiability_after_one_action": {
          "type": "string",
          "enum": [
            "non_identifiable",
            "identifiable"
          ]
        },
        "informative_actions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "HOLD",
              "LEFT",
              "RIGHT",
              "OBLIQUE",
              "HEIGHT",
              "ZOOM",
              "REPEAT"
            ]
          }
        },
        "abstention_allowed": {
          "const": true
        },
        "action_outcomes_source": {
          "type": "string",
          "minLength": 1
        },
        "expected_observations_by_action": {
          "type": "array",
          "minItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "actions",
              "expected_observation"
            ],
            "properties": {
              "actions": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "enum": [
                    "HOLD",
                    "LEFT",
                    "RIGHT",
                    "OBLIQUE",
                    "HEIGHT",
                    "ZOOM",
                    "REPEAT",
                    "STOP",
                    "ABSTAIN"
                  ]
                }
              },
              "expected_observation": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "policy_logic": {
          "type": "string",
          "minLength": 1
        },
        "safe_rule": {
          "type": "string",
          "minLength": 1
        },
        "metric": {
          "type": "string",
          "minLength": 1
        },
        "risk_or_failure_mode": {
          "type": "string",
          "minLength": 1
        },
        "paired_scene_id": {
          "type": "string",
          "enum": [
            "01",
            "02",
            "03",
            "04",
            "05",
            "06",
            "07",
            "08",
            "09",
            "10"
          ]
        },
        "pair_and_controls": {
          "type": "string",
          "minLength": 1
        },
        "holdout_group": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}

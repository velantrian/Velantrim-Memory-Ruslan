{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "zauchit-object-identity-occlusion-synthetic-scenes-2026-10-30-v1.schema.json",
  "title": "Zaучит illustrative object-identity scenes JSONL record",
  "description": "Schema for one of the ten previously written illustrative scenes. It does not certify a validated benchmark or any measurement.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "dataset_id",
    "scene_id",
    "module",
    "status",
    "execution_status",
    "pair_id",
    "pair_role",
    "paired_scene_ids",
    "observation_inputs",
    "initial_objects",
    "cue_reliability",
    "ground_truth",
    "ambiguity",
    "safe_response_policy",
    "matched_controls",
    "target_failure_modes",
    "metrics",
    "reward_and_cost"
  ],
  "properties": {
    "version": {"const": "2026-10-30-v1"},
    "dataset_id": {"const": "zauchit-object-identity-occlusion-synthetic-scenes"},
    "scene_id": {"type": "string", "pattern": "^(0[1-9]|10)$"},
    "module": {"enum": ["OBJ-01", "OBJ-02", "OBJ-03", "OBJ-04", "OBJ-05"]},
    "status": {"const": "SYNTHETIC / ILLUSTRATIVE / NOT TESTED"},
    "execution_status": {"const": "NOT RUN"},
    "pair_id": {"type": "string", "minLength": 1},
    "pair_role": {"type": "string", "minLength": 1},
    "paired_scene_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^(0[1-9]|10)$"}
    },
    "observation_inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["initial_visible_objects", "events", "available_actions"],
      "properties": {
        "initial_visible_objects": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["ref", "visible_features", "position"],
            "properties": {
              "ref": {"type": "string", "minLength": 1},
              "visible_features": {"type": "array", "items": {"type": "string"}},
              "position": {"type": "string"},
              "motion": {"type": "string"}
            }
          }
        },
        "events": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["t_start_s", "t_end_s", "visibility", "observation"],
            "properties": {
              "t_start_s": {"type": "number", "minimum": 0},
              "t_end_s": {"type": "number", "minimum": 0},
              "visibility": {"enum": ["visible", "partially_visible", "occluded"]},
              "observation": {"type": "string", "minLength": 1}
            }
          }
        },
        "available_actions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string"}
        }
      }
    },
    "initial_objects": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evaluator_only", "entities"],
      "properties": {
        "evaluator_only": {"const": true},
        "entities": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["stable_id", "stable_features"],
            "properties": {
              "stable_id": {"type": "string", "minLength": 1},
              "stable_features": {"type": "array", "minItems": 1, "items": {"type": "string"}},
              "initial_position": {"type": "string"}
            }
          }
        }
      }
    },
    "cue_reliability": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["cue", "r", "interpretation"],
        "properties": {
          "cue": {"type": "string", "minLength": 1},
          "r": {"type": "number", "minimum": 0, "maximum": 1},
          "interpretation": {"type": "string", "minLength": 1}
        }
      }
    },
    "ground_truth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evaluator_only",
        "input_exclusion",
        "observational_identifiability",
        "primary_branch_mappings",
        "matched_branch_mappings",
        "hidden_answer_is_model_input"
      ],
      "properties": {
        "evaluator_only": {"const": true},
        "input_exclusion": {"type": "string", "minLength": 1},
        "observational_identifiability": {"enum": ["identifiable", "identifiable-after-recheck", "non_identifiable"]},
        "primary_branch_mappings": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/mapping"}
        },
        "matched_branch_mappings": {
          "type": "array",
          "items": {"$ref": "#/$defs/mapping"}
        },
        "observationally_equivalent_alternatives": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["mapping", "relation"],
            "properties": {
              "branch": {"type": "string"},
              "mapping": {"type": "string"},
              "relation": {"type": "string"}
            }
          }
        },
        "hidden_answer_is_model_input": {"const": false}
      }
    },
    "ambiguity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["flag", "reason", "abstention_allowed"],
      "properties": {
        "flag": {"type": "boolean"},
        "reason": {"type": "string", "minLength": 1},
        "abstention_allowed": {"type": "boolean"},
        "scoring_note": {"type": "string"}
      }
    },
    "safe_response_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["before_recheck", "after_recheck", "abstention_policy"],
      "properties": {
        "before_recheck": {"type": "string"},
        "after_recheck": {"type": "string"},
        "abstention_policy": {"type": "string"}
      }
    },
    "matched_controls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["control_id", "scene_ids", "description"],
        "properties": {
          "control_id": {"type": "string", "minLength": 1},
          "scene_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^(0[1-9]|10)$"}
          },
          "description": {"type": "string", "minLength": 1},
          "varied_factor": {"type": "string"},
          "matched_factors": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "target_failure_modes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "metrics": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "reward_and_cost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["illustrative_scheme", "recheck_cost"],
      "properties": {
        "illustrative_scheme": {"type": "string"},
        "recheck_cost": {"type": "string"}
      }
    }
  },
  "$defs": {
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["branch", "mapping", "relation"],
      "properties": {
        "branch": {"type": "string"},
        "mapping": {"type": "string"},
        "relation": {"type": "string"},
        "visible_change": {"type": "string"},
        "post_recheck_cue": {"type": "string"}
      }
    }
  }
}
